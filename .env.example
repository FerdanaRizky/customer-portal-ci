CI_ENVIRONMENT = production
app.baseURL = 'https://portal.example.com/'
app.forceGlobalSecureRequests = true
encryption.key = 'REPLACE_WITH_EXACTLY_32_RANDOM_CHARACTERS'
database.default.hostname = localhost
database.default.database = customer_portal
database.default.username = customer_portal
database.default.password = CHANGE_ME
database.default.DBDriver = MySQLi
database.default.port = 3306

# Admin awal (jalankan seeder setelah migrate)
ADMIN_USERNAME = admin
ADMIN_PASSWORD = 'CHANGE_THIS_STRONG_PASSWORD'

# GenieACS NBI
GENIEACS_URL = 'http://127.0.0.1:7557'
GENIEACS_USERNAME =
GENIEACS_PASSWORD =

# GOWA Pesona yang sudah berjalan (sama dengan Pesona Cloud Drive)
gowa.baseURL = 'https://wa.pesonawifi.my.id'
gowa.deviceId = 'billing'
gowa.username =
gowa.password =
