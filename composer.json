{
  "name": "pesonawifi/customer-portal-ci",
  "description": "Pesona Wifi Customer Portal - CodeIgniter 4 native PHP edition",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.1",
    "codeigniter4/framework": "^4.6",
    "ext-curl": "*",
    "ext-fileinfo": "*",
    "ext-intl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-mysqli": "*"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Config\\": "app/Config/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
