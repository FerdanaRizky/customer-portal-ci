{
  "name": "pesonawifi/customer-portal-ci",
  "description": "Pesona Wifi Customer Portal - CodeIgniter 4 native PHP edition",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.1",
    "codeigniter4/framework": "^4.6",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-mysqli": "*",
    "ext-fileinfo": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "scripts": {
    "post-update-cmd": ["@php spark cache:clear"]
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
